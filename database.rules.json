{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "attendance": {
      ".indexOn": ["date"]
    },

    "transactions": {
      ".indexOn": ["date", "customerName", "customerPhone"]
    },
    "systemState": {
      "activeBills": {
        ".indexOn": ["id", "customerName", "date"]
      },
      "waitlist": {
        ".indexOn": ["id", "customerName", "status"]
      },
      "bookings": {
        ".indexOn": ["date", "status"]
      }
    },
    "crm": {
      "customers": {
        ".indexOn": ["phone", "normalizedName"]
      }
    }
  }
}